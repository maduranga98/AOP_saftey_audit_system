rules_version = '2';

// Roles come from custom claims ({ roles: [...] }) set only by Cloud Functions,
// so no rule needs an extra document read.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function roles() { return request.auth.token.roles; }
    function hasAnyRole() { return signedIn() && roles() is list && roles().size() > 0; }
    function hasRole(r) { return signedIn() && roles() is list && r in roles(); }
    function isAdmin() { return hasRole('admin'); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // Setup data: two documents read by every role, written by the safety officer.
    // Functions also write the people directory (Admin SDK bypasses rules).
    match /config/{docId} {
      allow read: if hasAnyRole();
      allow write: if isAdmin() && docId in ['main', 'checklists'];
    }

    // User records are managed only by Cloud Functions.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    // One document per audit. Immutable once written, except an admin void.
    match /audits/{auditId} {
      allow read: if isAdmin()
        || (signedIn() && (resource.data.auditorUid == request.auth.uid
                           || request.auth.uid in resource.data.assigneeIds));
      allow create: if hasRole('auditor')
        && request.resource.data.id == auditId
        && request.resource.data.auditorUid == request.auth.uid
        && request.resource.data.month is string
        && request.resource.data.month.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.subAreaId is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 60
        && request.resource.data.assigneeIds is list
        && !('voided' in request.resource.data);
      allow update: if isAdmin()
        && changed().hasOnly(['voided', 'voidReason', 'voidedBy', 'voidedAt'])
        && request.resource.data.voided == true
        && request.resource.data.voidedBy == request.auth.uid;
      allow delete: if false;
    }

    // One document per finding (score below 1). Closed by the area owner or manager with photo proof.
    match /actions/{actionId} {
      allow read: if isAdmin()
        || (signedIn() && (resource.data.raisedBy == request.auth.uid
                           || request.auth.uid in resource.data.assigneeIds));
      allow create: if hasRole('auditor')
        && request.resource.data.raisedBy == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.assigneeIds is list
        && actionId.matches('^' + request.resource.data.auditId + '_.+$');
      allow update: if hasRole('area')
        && request.auth.uid in resource.data.assigneeIds
        && resource.data.status == 'open'
        && request.resource.data.status == 'closed'
        && changed().hasOnly(['status', 'response', 'closedAt'])
        && request.resource.data.response.byUid == request.auth.uid
        && request.resource.data.response.comment is string
        && request.resource.data.response.photos is list
        && request.resource.data.response.photos.size() >= 1
        && request.resource.data.response.photos.size() <= 5;
      allow delete: if false;
    }

    // Monthly roll-ups for the dashboard, written only by Cloud Functions.
    match /summaries/{month} {
      allow read: if isAdmin() || hasRole('area');
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
